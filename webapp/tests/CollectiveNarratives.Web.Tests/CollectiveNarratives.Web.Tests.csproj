<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- De Unity-scripts gebruiken oude C#-stijl; hun meldingen horen hier niet thuis. -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CollectiveNarratives.Web\CollectiveNarratives.Web.csproj" />
  </ItemGroup>

  <!-- De SignalR-client van Unity (zonder Unity-code), zodat we hem tegen de echte server kunnen testen. -->
  <ItemGroup>
    <Compile Include="..\..\..\CN_VR\Assets\ApplicationConnection\Scripts\Net\*.cs" Link="Unity\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
